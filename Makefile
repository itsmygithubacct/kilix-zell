	$(BUILD)/voice.o \
	$(BUILD)/history.o \
	$(BUILD)/sprites.o \
	$(BUILD)/room.o

TEST_OBJS := \
	$(BUILD)/test_scene.o \
	$(BUILD)/desktop.o \
	$(ART_OBJS) \
	$(BUILD)/scene.o \
	$(BUILD)/draw.o \
	$(BUILD)/router.o \
	$(BUILD)/model.o \
