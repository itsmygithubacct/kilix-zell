ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
MODULES ?= $(abspath $(ROOT)/../../kilix-modules)
# kitty-framebuffer: a checkout with kittyfb_write_control (0.2.4), which
# puts a copy on the clipboard between frames.
FB_DIR ?= $(MODULES)/kitty-framebuffer
# neuronte-display, packaged for the panes and the Command computer: a
# checkout with nd_scroll (0.2.4), for scrollback, the mouse and pastes.
DISPLAY_DIR ?= $(MODULES)/neuronte-display
KB_DIR := $(MODULES)/kitty-input/third_party/kitty_keyboard
SR_DIR := $(MODULES)/soft-raster
# neuronte-sdk, for its canvas. It must be a checkout that has
# src/neuronte_sdk_canvas.c.
NSDK_DIR ?= $(MODULES)/neuronte-sdk
NSDK_CANVAS_C := $(NSDK_DIR)/src/neuronte_sdk_canvas.c
NSDK_CANVAS_H := $(NSDK_DIR)/include/neuronte_sdk_canvas.h
BUILD := $(ROOT)/build

CC ?= cc
CFLAGS ?= -O2 -g
CPPFLAGS += -MMD -MP -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE \
	-I$(ROOT)/src -I$(FB_DIR)/include -I$(KB_DIR)/include -I$(SR_DIR)/include
WARNINGS := -Wall -Wextra -Wpedantic -Wconversion -Wshadow \
	-Wstrict-prototypes -Wmissing-prototypes -Wformat=2
override CFLAGS += -std=c11 -pthread $(WARNINGS)
LDLIBS := -lz -lm

# The art is generated by tools/compile_desktop.py, one file per source sheet.
ART_OBJS := $(patsubst $(ROOT)/src/desktop_art/%.c,$(BUILD)/art_%.o,$(wildcard $(ROOT)/src/desktop_art/*.c))

LIB_OBJS := \
	$(BUILD)/kitty_framebuffer.o \
	$(BUILD)/kitty_keyboard.o \
	$(BUILD)/kitty_keyboard_posix.o \
	$(BUILD)/soft_raster.o

APP_OBJS := \
