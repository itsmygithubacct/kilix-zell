$(BUILD)/room.o: $(ROOT)/src/room.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(BUILD)/router.o: $(ROOT)/src/router.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(BUILD)/model.o: $(ROOT)/src/model.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(BUILD)/voice.o: $(ROOT)/src/voice.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(BUILD)/history.o: $(ROOT)/src/history.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(BUILD)/test_scene.o: $(ROOT)/tests/test_scene.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

# Like the canvas below: the stamp names the framebuffer checkout and sums
# its source and header, so a build against another checkout compiles what
# includes it again; its recipe turns away a checkout from before 0.2.4.
FB_STAMP := $(BUILD)/fb.ident

$(FB_STAMP): FORCE | $(BUILD)
	@grep -q kittyfb_write_control "$(FB_DIR)/include/kitty_framebuffer.h" 2>/dev/null || { \
		echo "zell: FB_DIR '$(FB_DIR)' has no kittyfb_write_control. Set FB_DIR to a kitty-framebuffer checkout from 0.2.4 (work/0.2.4-control-write)." >&2; \
		exit 2; }
	@{ printf '%s\n' '$(abspath $(FB_DIR))'; cksum < "$(FB_DIR)/src/kitty_framebuffer.c"; cksum < "$(FB_DIR)/include/kitty_framebuffer.h"; } > $@.new
	@if cmp -s $@.new $@; then rm -f $@.new; else mv $@.new $@; fi

$(BUILD)/kitty_framebuffer.o: $(FB_STAMP) | $(BUILD)
	$(CC) $(filter-out -MMD -MP,$(CPPFLAGS)) -I$(FB_DIR)/src $(CFLAGS) -c "$(FB_DIR)/src/kitty_framebuffer.c" -o $@

$(BUILD)/main.o $(BUILD)/main_neuronte.o: $(FB_STAMP)

$(BUILD)/kitty_keyboard.o: $(KB_DIR)/src/kitty_keyboard.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(BUILD)/kitty_keyboard_posix.o: $(KB_DIR)/src/kitty_keyboard_posix.c | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(BUILD)/soft_raster.o: $(SR_DIR)/src/soft_raster.c | $(BUILD)
	$(CC) $(CPPFLAGS) -I$(SR_DIR)/src $(CFLAGS) -c $< -o $@

# The canvas of the Neuronte programs, which do not link soft-raster: the
# pixel buffer, the clear, the flat fill, the RGBA packing and the PPM
# writer. The work is neuronte-sdk's canvas; canvas.o carries Zell's canvas
# struct across to it. It reads the soft-raster header for that struct only.
#
# The two objects hold one neuronte-sdk checkout's code. NSDK_STAMP records
# which checkout and a checksum of its two canvas files, and is rewritten
# only when one of them changes, so a build against another checkout, or
# the same one after an edit, compiles both again. The objects depend on
# the stamp and not on the checkout's files, so a checkout that has since
# been removed does not stop a build against another. Its recipe is also
# where a checkout with no canvas is turned away.
NSDK_STAMP := $(BUILD)/nsdk.ident

$(NSDK_STAMP): FORCE | $(BUILD)
	@test -f "$(NSDK_CANVAS_C)" && test -f "$(NSDK_CANVAS_H)" || { \
		echo "zell: NSDK_DIR '$(NSDK_DIR)' has no canvas. Set NSDK_DIR to a neuronte-sdk checkout with src/neuronte_sdk_canvas.c." >&2; \
		exit 2; }
	@{ printf '%s\n' '$(abspath $(NSDK_DIR))'; cksum < "$(NSDK_CANVAS_C)"; cksum < "$(NSDK_CANVAS_H)"; } > $@.new
	@if cmp -s $@.new $@; then rm -f $@.new; else mv $@.new $@; fi

$(BUILD)/canvas.o: $(ROOT)/src/canvas.c $(ROOT)/src/canvas.h $(NSDK_STAMP) | $(BUILD)
	$(CC) $(CPPFLAGS) -I$(NSDK_DIR)/include $(CFLAGS) -c $< -o $@

# The work behind it: neuronte-sdk's canvas, one file that includes nothing
# of Neuronte. It is compiled with no dependency file: one would name the
# checkout's source, and the stamp already covers it. CANVAS_OBJS is the
# pair every Neuronte program links.
$(BUILD)/nsdk_canvas.o: $(NSDK_STAMP) | $(BUILD)
	$(CC) $(filter-out -MMD -MP,$(CPPFLAGS)) -I$(NSDK_DIR)/include $(CFLAGS) -c "$(NSDK_CANVAS_C)" -o $@

CANVAS_OBJS := $(BUILD)/canvas.o $(BUILD)/nsdk_canvas.o

.PHONY: test-nsdk-ident
test: test-nsdk-ident
test-nsdk-ident:
	python3 $(ROOT)/tests/test_nsdk_ident.py "$(NSDK_DIR)" "$(MODULES)"

# The canvas beside soft-raster, call for call: the two must give the same bytes.
$(BUILD)/test_canvas.o: $(ROOT)/tests/test_canvas.c $(ROOT)/src/canvas.h | $(BUILD)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(BUILD)/test-canvas: $(BUILD)/test_canvas.o $(CANVAS_OBJS) $(BUILD)/soft_raster.o | $(BUILD)
	$(CC) $(CFLAGS) $^ -lm -o $@

.PHONY: test-canvas
test: test-canvas
test-canvas: $(BUILD)/test-canvas
	$(BUILD)/test-canvas

test: $(BUILD)/test-scene
	$(BUILD)/test-scene

# The Neuronte renderer, beside the default one: `make RENDER=neuronte`
# builds zell-neuronte, in which Neuronte nets draw the text, the outlines
# and the pictures. NEURONTE is a
# checkout of that library with `make` run in it. The default build above
# does not need it.
NEURONTE ?= $(HOME)/projects/neuronte
NEURONTE_WEIGHTS ?= $(NEURONTE)/weights/neuronte-split-v4.nrt
NEURONTE_LIB := $(NEURONTE)/build/libneuronte.a
N_CPPFLAGS := $(CPPFLAGS) -I$(NEURONTE)/include -DZELL_RENDER_NEURONTE \
	-DZELL_NEURONTE_WEIGHTS='"$(NEURONTE_WEIGHTS)"'

# Objects compiled with N_CPPFLAGS hold that checkout's headers and the
# weights path. This file records both, and is rewritten only when either
# changes, so a build against another checkout compiles those objects again.
N_IDENT := $(abspath $(NEURONTE)) $(NEURONTE_WEIGHTS)
N_STAMP := $(BUILD)/neuronte.ident
N_OBJS := \
	$(BUILD)/draw_neuronte.o \
	$(BUILD)/main_neuronte.o \
	$(BUILD)/snap_neuronte.o \
	$(BUILD)/test_neuronte.o \
	$(BUILD)/test_scene_neuronte.o \
	$(BUILD)/test_process_neuronte.o \
	$(BUILD)/test_desktop_neuronte.o

.PHONY: FORCE
FORCE:

$(N_STAMP): FORCE | $(BUILD)
	@printf '%s\n' '$(N_IDENT)' | cmp -s - $@ || printf '%s\n' '$(N_IDENT)' > $@

$(N_OBJS): $(N_STAMP)

.PHONY: test-neuronte-ident
test-neuronte: test-neuronte-ident
test-neuronte-ident:
	python3 $(ROOT)/tests/test_neuronte_ident.py "$(NEURONTE)"

N_COMMON := \
	$(BUILD)/desktop.o \
	$(ART_OBJS) \
	$(BUILD)/scene.o \
	$(BUILD)/draw_neuronte.o \
	$(BUILD)/router.o \
	$(BUILD)/model.o \
	$(BUILD)/voice.o \
	$(BUILD)/history.o \
	$(BUILD)/sprites.o \
	$(BUILD)/room.o

SNAP_COMMON := \
	$(BUILD)/desktop.o \
	$(ART_OBJS) \
	$(BUILD)/scene.o \
	$(BUILD)/router.o \
	$(BUILD)/model.o \
	$(BUILD)/voice.o \
	$(BUILD)/history.o \
	$(BUILD)/sprites.o \
	$(BUILD)/room.o \
	$(BUILD)/soft_raster.o

# Same link as LIB_OBJS, with the canvas pair where that has soft-raster.
N_LIB_OBJS := \
	$(BUILD)/kitty_framebuffer.o \
	$(BUILD)/kitty_keyboard.o \
	$(BUILD)/kitty_keyboard_posix.o \
	$(CANVAS_OBJS)

SNAP_NEURONTE := \
	$(BUILD)/desktop.o \
	$(ART_OBJS) \
	$(BUILD)/scene.o \
	$(BUILD)/router.o \
	$(BUILD)/model.o \
	$(BUILD)/voice.o \
	$(BUILD)/history.o \
	$(BUILD)/sprites.o \
	$(BUILD)/room.o \
	$(CANVAS_OBJS)

